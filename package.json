{
  "name": "start-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "prepare": "lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "pre-commit": "lefthook run pre-commit"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@shadcn/lint": "0.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "^2.8.17",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
