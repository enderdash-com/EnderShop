{
  "name": "start-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint && bun run knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "prepare": "lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "pre-commit": "lefthook run pre-commit",
    "knip": "knip"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@shadcn/lint": "0.2.5",
    "@tanstack/eslint-plugin-query": "5.108.2",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "^2.8.17",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
