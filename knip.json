{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/**/*.test.ts",
        "cloudflare.config.ts"
      ],
      "project": ["src/**/*.{css,ts,tsx}", "*.ts", "!src/routeTree.gen.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/ui": {
      "project": ["src/**/*.{css,ts,tsx}"]
    }
  }
}
