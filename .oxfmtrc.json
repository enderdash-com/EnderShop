{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva", "clsx", "twMerge"]
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".turbo/",
    ".output/",
    ".nitro/",
    ".tanstack/",
    ".vinxi/",
    ".cloudflare/",
    "coverage/",
    "apps/web/drizzle/",
    "apps/web/src/routeTree.gen.ts"
  ]
}
