{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cf dev",
    "build": "bun run cf-typegen && cf build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "cf deploy",
    "cf-typegen": "cf workers types",
    "db:generate": "drizzle-kit generate",
    "db:apply:local": "wrangler d1 migrations apply DB --local",
    "db:apply:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "test": "bun test src/lib/server src/lib/shop/input-schemas.test.ts"
  },
  "dependencies": {
