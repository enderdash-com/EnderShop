{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "react",
    "jsx-a11y",
    "effecttsgo"
  ],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [
    "**/.cloudflare/**",
    "**/.output/**",
    "**/.tanstack/**",
    "**/dist/**",
    "apps/web/drizzle/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/src/components/auth/**",
    "packages/ui/src/components/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effecttsgo/multiple-effect-provide": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-floating-promises": "off"
      }
    },
    {
      // The vendored Better Auth UI components in src/components/auth import
      // these plugins, and the plugins register those components. Breaking the
      // cycle needs changes to the vendored code.
      "files": [
        "apps/web/src/lib/auth/delete-user-plugin.ts",
        "apps/web/src/lib/auth/theme-plugin.ts"
      ],
      "rules": {
        "import/no-cycle": "off"
      }
    },
    {
      // TanStack route files export Route and keep their page components local.
      "files": ["apps/web/src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ],
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "import/first": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",
    "import/no-named-as-default": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/react-in-jsx-scope": "off",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "text-[10px]",
          "tracking-[0.18em]",
          "tracking-[0.22em]",
          "tracking-[0.24em]",
          "tracking-[0.3em]"
        ]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": "off",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "typescript/array-type": [
      "error",
      { "default": "generic", "readonly": "generic" }
    ],
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": false, "ts-ignore": "allow-with-description" }
    ],
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports" }
    ],
    "typescript/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "typescript/no-namespace": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/prefer-for-of": "error",
    "unicorn/no-array-sort": "off",
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/leaking-requirements": "off",
    "effecttsgo/strict-effect-provide": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": ["Redirect", "NotFoundError"],
            "package": "@tanstack/router-core"
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-console": "error",
    "eslint/no-await-in-loop": "off",
    "import/no-cycle": "error",
    "promise/catch-or-return": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "error",
    "react/jsx-no-target-blank": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-unknown-property": "error",
    "react/only-export-components": "error"
  }
}
